# Copy to .env and adjust. Every value is optional; the app runs with none of them set.

# Which AI provider does the analysis: anthropic | openai | rules | auto
# "auto" uses anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else rules.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model override. Defaults: claude-opus-5 (anthropic), gpt-4.1 (openai).
# claude-sonnet-5 is a good cheaper/faster option.
# LLM_MODEL=claude-sonnet-5

# Optional: let a different provider own the typed judgment (priority, waiting_on, urgency).
# Leave unset to use LLM_PROVIDER for both judgment and generation (the default).
# Set to "jev" to use TypeSafe's Jev for judgment while the LLM keeps writing the narrative.
# JUDGMENT_PROVIDER=jev
TYPESAFE_API_KEY=

# Demo clock. The sample data ends on 2026-08-31, so pin "today" to keep the dashboard sensible.
# Remove this line to use the real date.
CRM_TODAY=2026-09-01

# Storage. SQLite file by default; any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
DATABASE_URL=sqlite:///./crm.db
